<?xml version="1.0" encoding="utf-8"?>
<!-- ECHO stores captured evidence locally and never syncs it, so backups are
     disabled outright: evidence must not leave the device via cloud backup. -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="file" />
    <exclude domain="external" />
</full-backup-content>
